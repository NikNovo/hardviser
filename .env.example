# Browser build (Vite embeds every VITE_* value in public JavaScript).
# Never put a secret, private URL, or production credential in a VITE_* variable.
VITE_TURNSTILE_SITE_KEY=
VITE_REVENUECAT_ENVIRONMENT=sandbox
VITE_REVENUECAT_PUBLIC_KEY=
VITE_RAG_CHAT_ENABLED=false

# Vercel API Functions (server-side values; never expose to the browser).
RAG_CHAT_ENABLED=false
SEVERUS_RAG_BRIDGE_URL=
SEVERUS_RAG_BRIDGE_HMAC_KEY=
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
TURNSTILE_SECRET_KEY=
AUTH_ORIGIN=

# RevenueCat is sandbox-only. All identifiers and credentials stay empty here.
REVENUECAT_ENVIRONMENT=sandbox
REVENUECAT_APP_ID=
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_WEBHOOK_SIGNING_SECRET=
