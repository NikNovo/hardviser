# Backend service settings only. Copy to a private file, set owner/mode 0600,
# and supply authorized values out of band. Never commit real credentials.
SEVERUS_RAG_BRIDGE_HOST=127.0.0.1
SEVERUS_RAG_BRIDGE_PORT=8765
SEVERUS_RAG_BRIDGE_HMAC_KEY=

HIS_APP_DB_HOST=127.0.0.1
HIS_APP_DB_PORT=5432
HIS_APP_DB_NAME=hardviser_app
HIS_APP_DB_USER=app_runtime
HIS_APP_DATA_ROOT=/var/lib/hardviser/app-data

# This root must be provisioned separately with authorized KB runtime data/config.
HIS_KB_ROOT=/var/lib/hardviser/knowledge-base
HIS_KB_PUBLIC_CHAT_STATE_DB=/var/lib/hardviser/knowledge-base/runtime/public-chat/state.sqlite3
HIS_KB_PUBLIC_CHAT_OWNER_EXCEPTION=
HIS_KB_PUBLIC_CHAT_RELEASE_ID=
HIS_KB_PUBLIC_CHAT_COLLECTIONS=

MODEL_API_KEY=
REVENUECAT_ENVIRONMENT=sandbox
REVENUECAT_API_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_APP_ID=

# Backup overrides are optional; blank DB values inherit HIS_APP_DB_* settings.
HIS_APP_BACKUP_DB_HOST=
HIS_APP_BACKUP_DB_PORT=
HIS_APP_BACKUP_DB_NAME=
HIS_APP_BACKUP_DB_USER=
HIS_APP_BACKUP_CONFIG_FILE=/etc/hardviser/backend.env

# Required together with systemd's rclone credential to enable offsite backups.
HIS_APP_BACKUP_AGE_RECIPIENT=
HIS_APP_BACKUP_RCLONE_DESTINATION=
